# Supabase PostgreSQL connection string
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Replace [YOUR-PASSWORD] with your DB password (Settings → Database → Database password)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# DJC → Salesforce automation lives in its OWN Supabase project (separate from Kimedics).
# Leave unset to hide the DJC card. Get the URI from the DJC project's Database settings.
DJC_DATABASE_URL=postgresql://postgres.[DJC-PROJECT-REF]:[DJC-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Slack alerts ─────────────────────────────────────────────
# Slack bot token (xoxb-…). Scopes required: chat:write, chat:write.public.
# Create at api.slack.com/apps, install to workspace, invite bot to the channel.
SLACK_BOT_TOKEN=

# Slack channel id (C…). Stored as id (not name) so renames don't break the integration.
# Right-click channel in Slack → View channel details → bottom of pane.
SLACK_ALERT_CHANNEL_ID=

# Shared secret between Vercel Cron and the cron route. Generate with:
#   openssl rand -hex 32
# Vercel auto-injects this as the Authorization header when the env var name is exactly CRON_SECRET.
CRON_SECRET=

# Base URL of the deployed Automation Hub (no trailing slash). Used to build the "View in Automation Hub" link.
DASHBOARD_BASE_URL=https://automation-hub-rosy.vercel.app

# Salesforce org base URL (no trailing slash). Used to build per-record SF links.
# Example: https://proxi.lightning.force.com
SALESFORCE_INSTANCE_URL=

# DJC Candidate Bank (Job Board [Internal] Supabase) — read-only KPIs
CANDIDATE_BANK_DATABASE_URL=

# ─── Hub access control ────────────────────────────────────────
# Admins can open both the Proxi and Mohamed workspaces.
ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=

# Proxi client report. This cookie cannot open Mohamed or admin pages.
CLIENT_ACCESS_CODE=

# Mohamed review portal. This cookie cannot open Proxi or admin pages.
# Use at least 24 random characters; production login throttles repeated failures.
MOHAMED_ACCESS_CODE=

# Mohamed run ledger — its OWN Supabase project holding only the PHI-free run ledger
# (see /root/projects/mohamed/docs/run-ledger.md). Use the read-only `mohamed_hub_reader`
# role and the transaction pooler (port 6543). Leave unset to show the synthetic ledger.
MOHAMED_DATABASE_URL=

# ─── Marketing tab (Practice Story Engine) ─────────────────────
# OpenAI API key for real story-angle/content-draft generation (gpt-4o-mini by default,
# override with OPENAI_MODEL) and embeddings (text-embedding-3-small) used for real
# clustering/duplicate-detection. This is NOT the same as OPENAI_ADMIN_KEY (a separate
# billing-read key used only by the cost-sync cron) — do not reuse that key here.
# Leave unset to fall back to the deterministic local template generator and local
# hash-embedding clustering (no external account needed, see app/marketing/settings).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Marketing (Practice Story Engine) ───────────────────────
# Research pipeline runs on Modal (modal/marketing_research.py, workspace uzu-billing, every 6h),
# NOT a Vercel cron. Modal secret `marketing-research` carries DATABASE_URL + OPENAI_API_KEY.
# The hub only needs OPENAI_API_KEY for on-demand story/content generation in the UI.
